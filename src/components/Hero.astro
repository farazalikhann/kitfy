---
import { withBase } from '../utils/url';
---

<section class="mx-auto max-w-(--container-content) px-4 pb-16 pt-12 sm:px-6 sm:pb-24 sm:pt-16 lg:pb-32 lg:pt-20">
  <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-16">
    <div>
      <p class="font-mono text-xs font-medium text-accent">All ten, in one place</p>

      <h1 class="mt-4 text-3xl sm:text-4xl font-display font-bold tracking-(--tracking-display) text-fg">
        Small tools that do one job properly
      </h1>

      <p class="mt-6 max-w-[34ch] font-body text-base leading-relaxed text-fg-secondary">
        Every Kitfy tool runs inside your browser. Nothing is uploaded, nothing needs an account, and all of it is
        free.
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-6">
        <a
          href="#tools"
          class="inline-flex items-center justify-center rounded-button bg-ink px-6 py-3.5 font-body text-sm font-medium text-white transition-transform hover:-translate-y-0.5"
        >
          Browse the tools
        </a>
        <a
          href={withBase('/about')}
          class="font-body text-sm font-medium text-fg-secondary underline decoration-border underline-offset-4 transition-colors hover:text-fg"
        >
          What is Kitfy
        </a>
      </div>
    </div>

    <div class="flex justify-center lg:justify-end">
      <div class="kf-hero-grid" role="img" aria-label="The Kitfy logo mark, animating one tile at a time">
        <div class="kf-hero-tile" data-tile="0"></div>
        <div class="kf-hero-tile" data-tile="1"></div>
        <div class="kf-hero-tile" data-tile="2"></div>
        <div class="kf-hero-tile" data-tile="3"></div>
      </div>
    </div>
  </div>
</section>

<style>
  .kf-hero-grid {
    --tile: clamp(72px, 9vw, 116px);
    --gap: calc(var(--tile) * 0.2);
    --radius: calc(var(--tile) * 0.275);
    display: grid;
    grid-template-columns: repeat(2, var(--tile));
    grid-template-rows: repeat(2, var(--tile));
    gap: var(--gap);
    /* Reserve the exact box so nothing around the grid ever shifts. */
    width: calc(var(--tile) * 2 + var(--gap));
    height: calc(var(--tile) * 2 + var(--gap));
  }

  .kf-hero-tile {
    width: var(--tile);
    height: var(--tile);
    border-radius: var(--radius);
    background: var(--kf-text);
    transition:
      transform 0.4s cubic-bezier(0.22, 1, 0.36, 1),
      background-color 0.4s ease;
    will-change: transform;
  }

  .kf-hero-tile.is-active {
    background: var(--kf-accent);
    transform: translate(10%, -10%);
  }

  @media (prefers-reduced-motion: reduce) {
    .kf-hero-tile {
      transition: none;
    }
  }
</style>

<script>
  const grid = document.querySelector('.kf-hero-grid');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (grid && !prefersReducedMotion) {
    const tiles = Array.from(grid.querySelectorAll<HTMLElement>('.kf-hero-tile'));
    let activeIndex = 0;

    setInterval(() => {
      tiles[activeIndex]?.classList.remove('is-active');
      activeIndex = (activeIndex + 1) % tiles.length;
      tiles[activeIndex]?.classList.add('is-active');
    }, 2500);
  }
</script>
